# Client CMS Integration (legacy – used only for one-time migration)
# Get the site code from the client-cms website detail page
CLIENT_CMS_SITE_CODE=your-site-code-here
# The base URL of your client-cms API (e.g., http://localhost:8000 or https://your-domain.com)
CLIENT_CMS_API_URL=http://localhost:8000

# Admin auth
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2b$10$replace-with-bcrypt-hash
# Random 32+ byte hex string for signing session cookies
ADMIN_SESSION_SECRET=replace-with-random-32-byte-secret

# Operator service-to-service auth (client-cms → luxivie)
SEMPRE_OPERATOR_SERVICE_SECRET=replace-with-random-32-byte-secret
# client-cms Website ID that is allowed to operate this luxivie site
LUXIVIE_OPERATOR_WEBSITE_ID=1
# Public base URL for generated preview and editor handoff links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
